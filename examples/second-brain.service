# systemd user unit: cp to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now second-brain
[Unit]
Description=Second Brain background agent
After=network-online.target

[Service]
ExecStart=%h/.cargo/bin/sb daemon
Environment=SB_HOME=%h/second-brain
Restart=on-failure
RestartSec=30
# Low priority: it is a background secretary, not a foreground app.
Nice=10

[Install]
WantedBy=default.target
